{
  "name": "sategraph-prd-assistant",
  "main": "index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "services": [
    {"binding": "DATA", "service": "sategraph-prd-data", "entrypoint": "CatalogReader"},
    {"binding": "GRAPH", "service": "sategraph-prd-graph", "entrypoint": "GraphReader"}
  ]
}
