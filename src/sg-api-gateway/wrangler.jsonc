{
  "name": "sg-api-gateway",
  "main": "index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "services": [
    {"binding": "STATUS", "service": "sg-sync", "entrypoint": "StatusReader"},
    {"binding": "DATA", "service": "sg-data", "entrypoint": "CatalogReader"},
    {"binding": "GRAPH", "service": "sg-graph", "entrypoint": "GraphReader"},
    {"binding": "ASSISTANT", "service": "sg-assistant", "entrypoint": "AssistantReader"}
  ]
}
