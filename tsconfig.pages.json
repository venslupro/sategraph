{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": [], "jsx": "react-jsx",
    "allowImportingTsExtensions": true, "strict": true, "noEmit": true,
    "skipLibCheck": true, "verbatimModuleSyntax": true,
    "paths": {"#sgp4/*": ["./node_modules/satellite.js/dist/*"]}
  },
  "include": ["src/sg-pages/**/*.ts", "src/sg-pages/**/*.tsx"],
  "exclude": ["src/sg-pages/orbit-worker.ts"]
}
