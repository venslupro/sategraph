{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@sategraph/*": ["app/packages/*/src/index.ts"]
    }
  },
  "include": [
    "app/packages/*/src/**/*.ts",
    "app/packages/*/test/**/*.ts",
    "app/worker/api/src/**/*.ts",
    "app/worker/scheduler/src/**/*.ts",
    "app/page/src/**/*.ts",
    "app/page/src/**/*.tsx",
    "app/page/functions/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
